{
  "rewrites": [
    { "source": "/admin", "destination": "/admin/index.html" },
    { "source": "/admin/:path*", "destination": "/admin/:path*" },
    { "source": "/c/:slug", "destination": "/catalogo/index.html?slug=:slug" },
    { "source": "/catalogo/:slug", "destination": "/catalogo/index.html?slug=:slug" },
    { "source": "/catalogo", "destination": "/catalogo/index.html" },
    { "source": "/form", "destination": "/vendas/form/index.html" },
    { "source": "/form/:path*", "destination": "/vendas/form/:path*" },
    { "source": "/formulario", "destination": "/vendas/formulario/index.html" },
    { "source": "/formulario/:path*", "destination": "/vendas/formulario/:path*" },
    { "source": "/vendas/form", "destination": "/vendas/form/index.html" },
    { "source": "/vendas/form/:path*", "destination": "/vendas/form/:path*" },
    { "source": "/vendas/formulario", "destination": "/vendas/formulario/index.html" },
    { "source": "/vendas/formulario/:path*", "destination": "/vendas/formulario/:path*" },
    { "source": "/", "destination": "/vendas/lpb/index.html" },
    { "source": "/:slug", "destination": "/clientes/:slug/index.html" }
  ]
}
